rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    match /menu/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
